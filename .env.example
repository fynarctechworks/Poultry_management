# PoultryOS environment template
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — NEVER commit real secrets.
# NEVER paste real secrets into chat, issues, PRs, or memory files.

# ---- Supabase ----
# Project: poultryos-prod (ap-south-1 / Mumbai)
# Get fresh values from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://jusxngbfdmzhlybohell.supabase.co

# Public anon key — safe to ship in client bundles (RLS enforces access).
# Used by: Expo mobile app, Next.js web client.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — BYPASSES ALL RLS. Treat as full-DB admin password.
# Used by: Edge Functions only. NEVER ship to a client bundle.
# Store in Supabase Edge Function secrets, not here, in production.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret — used to verify Supabase-issued JWTs in custom code.
SUPABASE_JWT_SECRET=

# Database password — set during project creation, used for direct psql / migration tools.
SUPABASE_DB_PASSWORD=

# ---- Third-party (fill in as Day 1 tasks complete) ----
AISENSY_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=PLTYOS
MSG91_OTP_TEMPLATE_ID=
OPENWEATHERMAP_API_KEY=
