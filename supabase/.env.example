# =============================================================================
# Supabase Edge Function + local-stack secrets.
# These are set on the HOSTED project as Edge Function secrets
#   (supabase secrets set KEY=value)  and, for a LOCAL stack, read from this file
# (copy to supabase/.env). NEVER commit real values. NEVER prefix with NEXT_PUBLIC_.
# =============================================================================

# --- Core (auto-provided in hosted runtime; needed for local function runs) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Transactional email (Resend) — Layer 2 send-email function ---------------
# RESEND_API_KEY: from https://resend.com/api-keys (server-only).
RESEND_API_KEY=re_your_api_key
# MAIL_FROM: a VERIFIED Resend sender on your authenticated domain.
# Format: "Display Name <address@domain>".
MAIL_FROM=PoultryOS <noreply@poultryosadmin.infynarc.com>
# MAIL_REPLY_TO: where replies + footer "need help?" point.
MAIL_REPLY_TO=support@infynarc.com
# MAIL_SENDER_NAME / MAIL_PRODUCT_NAME: branding in the template engine.
MAIL_SENDER_NAME=PoultryOS
MAIL_PRODUCT_NAME=PoultryOS
# MAIL_APP_URL: app origin used to build links inside emails.
MAIL_APP_URL=https://poultryosadmin.infynarc.com

# --- Auth emails (Layer 1) — Supabase Auth custom SMTP via Resend -------------
# Used by config.toml [auth.email.smtp] when enabled = true (local), and mirrored
# in the hosted dashboard (Authentication > Emails > SMTP). The SMTP username is
# the literal "resend"; this password is a Resend API key.
RESEND_SMTP_PASSWORD=re_your_api_key

# --- Existing third-party integrations (unchanged; listed for completeness) ---
# AISENSY_API_KEY=...
# OPENWEATHER_API_KEY=...
# RAZORPAY_KEY_ID=...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
