# PoultryOS SaaS Control Center — operator app environment.
# Points at the SAME Supabase backend as the customer apps.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required: the Control Center operates across all tenants above RLS.
# NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Initial Super Admin seed (server-only; consumed by `npm run seed:admin`) ---
# Run ONCE after deploy. The script creates/locates the auth user, sets a
# force-password-change flag, and promotes them to the platform super_admin role.
# Supabase Auth hashes the password (argon2) — it is never stored in plaintext.
# NEVER expose these with a NEXT_PUBLIC_ prefix.
SUPER_ADMIN_EMAIL=gandiphanendra315@gmail.com
SUPER_ADMIN_PASSWORD=generate_a_secure_password
SUPER_ADMIN_NAME=Phanendra

# --- Transactional email ---
# The Control Center dispatches operator/system emails through the SAME
# send-email Edge Function (Layer 2) using the service-role key above — it never
# calls Resend directly. Provider creds (RESEND_API_KEY, MAIL_FROM, ...) live as
# Supabase Edge Function secrets (see supabase/.env.example), not here.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
