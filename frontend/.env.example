NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used exclusively by the SaaS Control Center (web/lib/control/*)
# to operate across all tenants above RLS. NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DEV-ONLY email verification shortcut. While we have no transactional email
# provider wired up, the verification link never reaches the inbox. Set BOTH of
# these to "true" in development to show a "Verify now (dev)" button on
# /verify-email that confirms the account directly via the service-role key.
# NEVER set these in production — leave them unset so the real email link is the
# only path. The server route (DEV_EMAIL_VERIFY) is the actual gate; the public
# flag only controls button visibility.
DEV_EMAIL_VERIFY=false
NEXT_PUBLIC_DEV_EMAIL_VERIFY=false
