NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used exclusively by the SaaS Control Center (web/lib/control/*)
# to operate across all tenants above RLS. NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site origin — used to build absolute links in transactional emails
# (invitations, etc.). Production: https://poultryosadmin.infynarc.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Transactional email (Layer 2: the send-email Edge Function) ---
# The web app never talks to Resend directly; it calls the send-email Edge
# Function with the service-role key above. These are read by that function on
# the Supabase side (set them as Edge Function secrets), and are listed here so
# the full surface is documented in one place. See docs/email/env-vars.md.
#   RESEND_API_KEY        — Resend API key (Edge Function secret; server-only)
#   MAIL_FROM             — verified sender, e.g. "PoultryOS <noreply@poultryosadmin.infynarc.com>"
#   MAIL_REPLY_TO         — support reply-to, e.g. support@infynarc.com
#   MAIL_SENDER_NAME      — display name, e.g. PoultryOS
#   MAIL_APP_URL          — app origin used in email links
